{
  "name": "timesheet-calculator",
  "version": "0.9.0",
  "description": "Timesheet calculator for ZKTeco attendance machines",
  "main": "./out/main/index.js",
  "author": "Bao Loc <baoloc1993@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "migrate": "tsx src/main/settings/migrate-cli.ts",
    "doctor": "tsx scripts/doctor.ts",
    "prep-build-cache": "node scripts/prep-build-cache.mjs",
    "mau-bang-luong": "node scripts/build-mau-bang-luong.mjs",
    "dist": "node scripts/build-mau-bang-luong.mjs && node scripts/prep-build-cache.mjs && electron-vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "exceljs": "^4.4.0",
    "node-zklib": "^1.3.0"
  },
  "devDependencies": {
    "@fluentui/react-components": "^9.54.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}
